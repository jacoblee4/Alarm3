var AlarmCodeAjax = Class.create();
AlarmCodeAjax.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    generateUniqueCode: function() {
        return new x_banun_bunow_al_0.AlarmCodeHelper().generateUniqueCode();
    },

    checkCodeInUse: function() {
        return new x_banun_bunow_al_0.AlarmCodeHelper().checkCodeInUse(
            this.getParameter('sysparm_alarm_code'),
            this.getParameter('sysparm_opened_for'));
    },

    getIssueAtBranch: function() {
        return new x_banun_bunow_al_0.AlarmCodeHelper().getIssueAtBranch(
            this.getParameter('sysparm_alarm_code'));
    },

    hasAlarmCode: function() {
        return new x_banun_bunow_al_0.AlarmCodeHelper().hasAlarmCode(
            this.getParameter('sysparm_employee'));
    },

    getAlarmCodeLocation: function() {
        var recordId = this.getParameter('sysparm_record_id');
        if (!recordId) {
            return '';
        }

        var gr = new GlideRecord('x_banun_bunow_al_0_alarm_codes');
        if (!gr.get(recordId)) {
            return '';
        }

        // Only one of these will have a value
        var branch = gr.getDisplayValue('branch');
        if (branch) {
            return branch;
        }
        return gr.getDisplayValue('building') || '';
    },

    type: 'AlarmCodeAjax'
});
